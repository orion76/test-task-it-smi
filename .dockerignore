# Контекст сборки образа: исключаем всё, что не нужно для `npm ci` и `nest build`.
# Каталог `data` намеренно НЕ исключён — он копируется в runtime-образ для сидинга.

# Зависимости и артефакты сборки — ставятся и собираются внутри образа
node_modules
dist
coverage

# Angular-клиент собирается в стадии `client-build` из своих манифестов и исходников: зависимости,
# готовый `dist` и кэш CLI в контексте backend-сборки не нужны и весят сотни мегабайт.
client/node_modules
client/dist
client/.angular

# Git и локальные бэкапы редактора
.git
.gitignore
.history

# Переменные окружения: секреты не попадают в образ
.env
.env.*
!.env.example

# Служебные каталоги и файлы workflow
.opencode
.vscode

# Временные файлы и логи
tmp
.tmp
.temp
*.log
