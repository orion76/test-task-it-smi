# Пример переменных окружения. Скопируйте файл в .env и подставьте свои значения.
# Сам .env в git не попадает (см. .gitignore).

# Строка подключения к PostgreSQL — обязательна: без неё не стартуют ни приложение,
# ни `prisma migrate deploy`, ни сидинг.
# Формат: postgresql://<пользователь>:<пароль>@<хост>:<порт>/<база>?schema=public
#
# Хост зависит от способа запуска:
#   - локальный запуск (`npm run start:dev`, `npm run prisma:migrate:dev`) — localhost:5432,
#     порт проброшен из контейнера `db` на хост;
#   - внутри docker compose — db:5432 (имя сервиса), это значение задано в docker-compose.yml
#     и переопределяет строку ниже.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/it_smi?schema=public

# Порт HTTP-сервера. Необязателен, по умолчанию 3000.
PORT=3000

# Режим работы приложения: development | production | test. По умолчанию development.
NODE_ENV=development
