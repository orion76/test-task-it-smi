{
  "name": "test-task-it-smi",
  "version": "1.0.0",
  "description": "The Backender's Business card test assignment",
  "license": "ISC",
  "author": "Paul Glazkow aka @orion76",
  "type": "commonjs",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.generators.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p packages/yaml-loader/tsconfig.json",
    "knip": "knip",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest -c jest-e2e.config.mjs",
    "build": "npm run build:lib && npm run prisma:generate && npm run validate:api-fields && nest build && npm run build:seed",
    "build:seed": "node -e \"require('node:fs').rmSync('dist/prisma', { recursive: true, force: true })\" && tsc -p tsconfig.seed.json",
    "build:lib": "node -e \"require('node:fs').rmSync('packages/yaml-loader/lib', { recursive: true, force: true })\" && tsc -p packages/yaml-loader/tsconfig.json",
    "prisma:generate": "prisma generate && node prisma/scripts/post-generate.mts",
    "validate:api-fields": "ts-node -T --project tsconfig.scripts.json scripts/api-fields.cli.ts",
    "postinstall": "node prisma/scripts/post-install.mts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node dist/prisma/seed/main.js",
    "schema:update": "SCHEMA_UPDATE=1 NODE_OPTIONS=--experimental-vm-modules jest tests/unit/graphql/schema.spec.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "npm run dev:prepare && concurrently -n api,web -c blue,green --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:prepare": "node scripts/require-env.mjs && npm run dev:db && prisma migrate deploy && node scripts/seed.mjs",
    "dev:db": "docker compose up -d db && node scripts/wait-for-db.mjs",
    "dev:api": "npm run start:dev",
    "dev:web": "npm --prefix client run dev",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:stop:all": "node scripts/dev-stop.mjs --db",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "^6.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.5.0",
    "yaml-loader": "file:./packages/yaml-loader"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@prisma/generator-helper": "^6.19.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "globals": "^17.14.0",
    "identity-type": "^1.0.0",
    "jest": "^30.5.2",
    "knip": "^6.44.1",
    "prisma-nestjs-graphql": "^23.2.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
