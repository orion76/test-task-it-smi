{
  "name": "it-smi-client",
  "version": "0.1.0",
  "description": "Manual GraphQL check tool for the it-smi backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "dev:docker": "ng serve --host 0.0.0.0 --port 5173 --proxy-config proxy.conf.docker.json",
    "build": "ng build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/forms": "~22.2.5",
    "@angular/platform-browser": "~22.2.5",
    "@apollo/client": "4.3.7",
    "apollo-angular": "14.2.0",
    "graphql": "^16.14.2",
    "rxjs": "7.8.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
