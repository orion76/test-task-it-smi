{
  // Отдельный проект для `scripts/`: эти файлы запускает `ts-node` из `npm run build`, они лежат
  // вне `src/` и `prisma/`, поэтому ни один существующий проект их не включает.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `types` задан явно: без него компилятор не подхватывает @types/node, а CLI использует
    // `console` и `process`.
    "types": ["node"],
    // Проект только проверяет типы: в вывод ничего не попадает, поэтому `outDir` наследуется
    // неиспользованным. `rootDir` из `tsconfig.json` (`./src`) переопределён на корень проекта:
    // CLI импортирует валидатор из `src/`, а проверка «файл вне rootDir» (TS6059) срабатывает и
    // при `noEmit`, так что каталог скриптов корнем программы быть не может.
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
