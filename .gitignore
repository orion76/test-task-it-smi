.history

# Зависимости
node_modules/
npm-debug.log*

# Собранные файлы
dist/
build/
coverage/
.rollup.cache/
# Кэш сборки Angular-клиента (client/.angular)
.angular/
# Артефакт `npm run build:lib` (tsc -p packages/yaml-loader/tsconfig.json): в репозиторий не коммитится
packages/yaml-loader/lib/

# Логи
logs/
*.log

# Временные файлы
.tmp/
.temp/

# Переменные окружения
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo


# Рабочие данные opencode: задачи, отчёты, релизы, локальный индекс (не исходники)
.opencode/

# Локальные заметки и рабочие документы (не исходники)
.local/
# Рабочая версия документации: в репозиторий не входит
.doc/

# Личные настройки редактора: .vscode/extensions.json (рекомендации расширений) остаётся в репозитории
.vscode/settings.json
