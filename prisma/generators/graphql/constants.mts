/**
 * Constants of the `graphql` generator: the names and the fallback directory of its artifacts and
 * the shape of every file it writes.
 */
import { API_FIELDS_FILE } from '../shared/constants.mts';

/** Files written into the generator output directory (`output` in `schema.prisma`). */
export const RELATIONS_FILE_NAME = 'relations.resolver.ts';
export const QUERIES_FILE_NAME = 'queries.resolver.ts';

/** Fallback when the schema declares no `output`: mirrors the value declared in `schema.prisma`. */
export const DEFAULT_OUTPUT = '../src/generated/graphql/resolvers';

/** Header of every generated file: it explains where the content comes from and how to change it. */
export const HEADER = `// This file is generated by prisma/generators/graphql/graphql.generator.mts from prisma/schema.prisma and
// ${API_FIELDS_FILE} — do not edit it by hand. Change the schema or the contract and run
// \`npm run prisma:generate\`.`;

/** Longest line the generated files may have: the project lints them like any other source. */
export const LINE_LIMIT = 100;
