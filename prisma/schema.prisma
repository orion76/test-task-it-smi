// Prisma schema for the business-card domain.
// Mirrors the data model fixed in tz-detail.md §5: seven models, one enum, no extra fields.
// The same schema is used by the NestJS data layer and by the seed (prisma/seed/main.ts).

generator client {
  provider = "prisma-client-js"
  // "native" is used for local development; "linux-musl-openssl-3.0.x" is required by the alpine
  // runtime image. Without the musl target the query engine cannot be loaded inside the container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// GraphQL object types are generated from the models below: the Prisma schema is the single
// source of truth of the domain. Only the fields listed in `config/api-fields.yml` reach the
// API, the rest is hidden with `@HideField()` (see
// `prisma/generators/nestgraphql/nestgraphql.config.mts`). The output is committed, like
// `src/schema.gql`.
generator nestgraphql {
  provider   = "prisma-nestjs-graphql"
  output     = "../src/generated/graphql/entities"
  configFile = "./generators/nestgraphql/nestgraphql.config.mts"
}

// JSON Schema of the API config (`config/api-fields.yml`): the config may name only models and
// columns declared below, so a typo becomes a build error instead of a field that silently leaves
// the API. Prisma passes the DMMF to the generator over its own protocol, so the datamodel stays
// the single source of truth and the application never reads `Prisma.dmmf` at runtime.
// The provider is a local Node script rather than a published package: `provider` is spawned as a
// shell command from the project root. The artifact is committed into `config/`, where the build
// step and the running application read it at the same relative path.
generator apiFields {
  provider = "node ./prisma/generators/api-fields/api-fields.generator.mts"
  output   = "../config"
}

// GraphQL declarations of the API (`src/generated/graphql/resolvers/*.resolver.ts`): the nested
// relations and the top-level queries. Both are facts of the schema plus `config/api-fields.yml`, so
// they are generated instead of being written by hand; behaviour lives in `EntityLoader` and
// `EntityQueries`. The artifacts are committed, like the generated entity classes.
generator graphql {
  provider = "node ./prisma/generators/graphql/graphql.generator.mts"
  output   = "../src/generated/graphql/resolvers"
}

// JSON Schema of the seed data (`config/profile-data.schema.yml`): the import file has to describe
// the rows these models declare, so the structure is generated from the DMMF. Only what Prisma
// cannot express (`format: date`, URL patterns, the `version` envelope) comes from
// `prisma/generators/seed-schema/seed-schema.config.mts`; no annotation DSL is added to this file.
// The artifact is committed: the seed reads it at startup, in the image as well. A divergence is
// caught by `tests/unit/generated/artifacts.parity.spec.ts`, which regenerates the file in a
// disposable copy of the project and compares it byte for byte with the committed one.
generator seedSchema {
  provider = "node ./prisma/generators/seed-schema/seed-schema.generator.mts"
  output   = "../config"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every model carries a `type` column: it is the discriminant of a row, `{ id, type }`
// (`src/common/contracts/entity.ts`). The values are spelled exactly as the Prisma client names its
// delegates (`profile`, `socialLink`, …), so a table has one name in the schema, in the client and
// in the code that selects it. Two properties of the column are deliberate:
// - `String`, not a Prisma `enum`: an enum is emitted into `schemaEnums`, the GraphQL generator
//   picks it up through `emitBlocks: ['models']` and the new enum would appear in `src/schema.gql`;
// - `@default` is mandatory: the seed builds rows from the JSON Schema `data/profile.yml`, which
//   knows nothing about this column, so the database has to fill it.

/// Владелец визитки
model Profile {
  id          String   @id @default(uuid())
  type        String   @default("profile")
  /// Идентификатор визитки латиницей в kebab-case.
  slug        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  experience  Experience[]
  projects    Project[]
  // A skill and a link are dictionary rows shared between profiles, so the collection of a profile is
  // a list of the rows of the tie table, not a column of this one. The API still publishes `skills`
  // and `links`; the loader reads them through `ProfileSkill` and `ProfileSocialLink`.
  profileSkills      ProfileSkill[]
  profileSocialLinks ProfileSocialLink[]
}

/// Тип ссылки — GITHUB, LINKEDIN, WEBSITE или OTHER
enum SocialKind {
  GITHUB
  LINKEDIN
  WEBSITE
  OTHER
}

/// Внешняя ссылка — строка справочника, общая для профилей, которые её указывают
model SocialLink {
  id                 String              @id @default(uuid())
  type               String              @default("socialLink")
  label              String
  url                String              @unique
  /// Тип ссылки — одно из значений `SocialKind`.
  kind               SocialKind
  profileSocialLinks ProfileSocialLink[]

  // Narrowing by the first keys of the read order (`kind`, `label`). The order has no column of its
  // own: it follows from the values, and the database sorts the tail (`id`).
  @@index([kind, label])
}

/// Навык — строка справочника, общая для профилей, которые его указывают
model Skill {
  id            String         @id @default(uuid())
  type          String         @default("skill")
  name          String         @unique
  /// Свободная группировка: «language», «backend», «database», …
  category      String?
  profileSkills ProfileSkill[]

  // Narrowing by the first keys of the read order (`category`, `name`). An empty category sorts last
  // by an explicit rule of the read, not by a database default; the tail (`id`) is sorted by the
  // database.
  @@index([category, name])
}

/// Tie of one profile to one skill. The dictionary row itself is shared between profiles.
model ProfileSkill {
  id        String  @id @default(uuid())
  type      String  @default("profileSkill")
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // A profile lists a skill once; the narrowing read of one collection starts from the parent.
  @@unique([profileId, skillId])
  @@index([profileId])
}

/// Tie of one profile to one link. The dictionary row itself is shared between profiles.
model ProfileSocialLink {
  id           String     @id @default(uuid())
  type         String     @default("profileSocialLink")
  profileId    String
  socialLinkId String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  socialLink   SocialLink @relation(fields: [socialLinkId], references: [id], onDelete: Cascade)

  // A profile lists a link once; the narrowing read of one collection starts from the parent.
  @@unique([profileId, socialLinkId])
  @@index([profileId])
}

/// Место работы владельца визитки
model Experience {
  id           String    @id @default(uuid())
  type         String    @default("experience")
  profileId    String
  company      String
  position     String
  /// Календарная дата в формате `YYYY-MM-DD`. У периода работы нет ни времени суток, ни часового пояса.
  startedAt    DateTime
  /// Календарная дата в формате `YYYY-MM-DD`, или `null`, пока работа является текущей. Пару
  /// `finished`/`endedAt` проверяет сидинг при записи строки; чтение ничего не проверяет и возвращает строку как есть.
  endedAt      DateTime?
  /// Признак завершённого места работы. `false` — работаю по сей день, и тогда `endedAt` пуст; у владельца
  /// может быть несколько мест работы одновременно, поэтому это факт о строке, а не о недостающей дате.
  /// `NOT NULL DEFAULT false`, поэтому строки, записанные до появления признака, читаются как `false`.
  finished     Boolean   @default(false)
  achievements String[]
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Narrowing by `profileId` plus the first key of the read order (`startedAt`, the latest job
  // first). The order has no column of its own: it follows from the date, and the database sorts the
  // tail (`id`). `finished` keeps its own index for the filter by the flag.
  @@index([profileId, startedAt])
  @@index([finished])
}

/// Проект владельца визитки
model Project {
  id          String  @id @default(uuid())
  type        String  @default("project")
  profileId   String
  name        String
  url         String?
  description String?
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Narrowing by `profileId` plus the first key of the read order (`name`). The order has no column
  // of its own: it follows from the name, and the database sorts the tail (`id`).
  @@index([profileId, name])
}
