/**
 * Constants of the post-processing of the `prisma-nestjs-graphql` output: the shape of the named
 * imports it drops, the directory the walk starts from and the header that marks a generated file.
 */
import { join } from 'node:path';

import { projectRoot } from 'yaml-loader';

/** Single-line named import, the only shape the generator emits. */
export const NAMED_IMPORT = /^import (type )?\{([^}]+)\} from ('[^']+');$/gm;

/**
 * Project root, found by `projectRoot` from this file: the walk up to the nearest `package.json`
 * does not depend on the working directory and survives a move of the scripts.
 */
export const PROJECT_ROOT = projectRoot(import.meta.dirname);

/** Output of the GraphQL generators: the entity declarations this pipeline post-processes. */
export const OUTPUT_DIRECTORY = join(
  PROJECT_ROOT,
  'src',
  'generated',
  'graphql',
  'entities',
);

/**
 * Header of every generated file: who writes it, from what and how to change it. Same shape as the
 * `HEADER` of the `graphql` generator (`prisma/generators/graphql/constants.mts`), so both trees
 * under `src/generated/graphql` read alike.
 */
export const FILE_HEADER = `// This file is generated by prisma-nestjs-graphql from prisma/schema.prisma and the config
// prisma/generators/nestgraphql/nestgraphql.config.mts — do not edit it by hand. Only the fields of
// config/api-fields.yml reach the API: change the schema, the config or the contract and run
// \`npm run prisma:generate\`.`;

/** First line of the header, i.e. what tells a stamped file from a freshly generated one. */
export const FILE_HEADER_MARKER =
  '// This file is generated by prisma-nestjs-graphql from prisma/schema.prisma';
